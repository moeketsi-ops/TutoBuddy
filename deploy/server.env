# Non-secret settings for katlego-server. Secrets live in /opt/katlego/*.env.
WHATSAPP_PHONE_NUMBER_ID=1352337571306417
# Katlego's public number (wa.me link a guardian opens to confirm consent).
WHATSAPP_PUBLIC_NUMBER=27760527446
GRAPH_API_BASE_URL=https://graph.facebook.com
LLM_PROVIDER=openrouter
OPENROUTER_ROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_REASONER_MODEL=openai/gpt-6-luna
OPENROUTER_VISION_MODEL=openai/gpt-6-luna
EMBEDDINGS_PROVIDER=hash
EMBEDDING_DIM=384
PROMPT_LAYOUT=layered
REDIS_URL=redis://redis:6379/0

# Bridge
AWS_REGION=eu-west-1
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/070780358345/katlego-inbound.fifo
# Testing only: just these WhatsApp numbers reach Katlego. Empty = everyone.
# Now empty: the access gate below decides who gets in.
ALLOW_FROM=

# Access gate (app/orchestrator/access.py): pilot and demo codes.
ACCESS_GATE=on
ACCESS_ADMIN_PHONES=27787738580

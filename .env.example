# ── Katlego (TutoBuddy) local environment ─────────────────────────────────────
# Copy to .env:   cp .env.example .env
# Everything runs locally with the defaults below — no keys required.
# Fill the REPLACE_ME values only when the real third-party accounts exist.

# ── Meta / WhatsApp Cloud API (Phase 0 sign-ups — see TECHNICAL_BLUEPRINT.md §3)
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_VERIFY_TOKEN=katlego-verify-token
META_APP_SECRET=REPLACE_ME

# Leave pointing at the mock for local dev; set to https://graph.facebook.com to go live.
GRAPH_API_BASE_URL=http://mockwa:8001

# ── LLM (two-tier per blueprint §4.2: cheap router + frontier reasoner)
# stub = canned Socratic replies, fully offline | anthropic = real Claude |
# groq = free/cheap hosted open gpt-oss models | ollama = fully local, no key
# Note: photo/vision help (homework photos) only works with anthropic for now.
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=REPLACE_ME
ROUTER_MODEL=claude-haiku-4-5-20251001
REASONER_MODEL=claude-sonnet-5

# groq: console.groq.com -> API Keys
GROQ_API_KEY=REPLACE_ME
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_REASONER_MODEL=openai/gpt-oss-120b

# ollama: no key. host.docker.internal is Docker Desktop's hostname for the
# machine Ollama is actually running on (it's not containerized here).
# Model names below are a guess, not a verified default -- check what you've
# actually pulled with `ollama list` and set these to match.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ROUTER_MODEL=llama3.2
OLLAMA_REASONER_MODEL=llama3.2

# ── Speech-to-text for voice notes
# stub = fixed transcript | local = faster-whisper container (no key) | openai = Whisper API
STT_PROVIDER=local
STT_BASE_URL=http://stt:9000
OPENAI_API_KEY=REPLACE_ME

# ── Embeddings for RAG over the CAPS corpus
# hash = deterministic offline embedder (no key) | openai = text-embedding-3-small
EMBEDDINGS_PROVIDER=hash
EMBEDDING_DIM=384

# ── Infra (matches docker-compose.yml; no changes needed locally)
DATABASE_URL=postgresql://katlego:katlego@db:5432/katlego
REDIS_URL=redis://redis:6379/0

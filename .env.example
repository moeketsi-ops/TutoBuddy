# ── Katlego (TutoBuddy) local environment ─────────────────────────────────────
# Copy to .env:   cp .env.example .env
# Everything runs locally with the defaults below — no keys required.
# Fill the REPLACE_ME values only when the real third-party accounts exist.

# ── Meta / WhatsApp Cloud API (Phase 0 sign-ups — see TECHNICAL_BLUEPRINT.md §3)
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_VERIFY_TOKEN=katlego-verify-token
META_APP_SECRET=REPLACE_ME
# Katlego's own WhatsApp number, digits only (e.g. 27600000000). Builds the
# wa.me link a guardian opens to confirm consent from their own phone.
WHATSAPP_PUBLIC_NUMBER=

# Leave pointing at the mock for local dev; set to https://graph.facebook.com to go live.
GRAPH_API_BASE_URL=http://mockwa:8001

# ── LLM (two-tier per blueprint §4.2: cheap router + frontier reasoner)
# stub = canned Socratic replies, fully offline | anthropic = real Claude |
# groq = free/cheap hosted open gpt-oss models | ollama = fully local, no key |
# openrouter = OpenAI-compatible hosted API (e.g. GPT-6 Luna, GLM-5.3 Flash)
# Note: photo/vision help (homework photos) works with anthropic OR
# openrouter (if its selected model is vision-capable) -- not groq/ollama.
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=REPLACE_ME
ROUTER_MODEL=claude-haiku-4-5-20251001
REASONER_MODEL=claude-sonnet-5

# groq: console.groq.com -> API Keys
GROQ_API_KEY=REPLACE_ME
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_REASONER_MODEL=openai/gpt-oss-120b

# ollama: no key. host.docker.internal is Docker Desktop's hostname for the
# machine Ollama is actually running on (it's not containerized here).
# Model names below are a guess, not a verified default -- check what you've
# actually pulled with `ollama list` and set these to match.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ROUTER_MODEL=llama3.2
OLLAMA_REASONER_MODEL=llama3.2

# openrouter: openrouter.ai -> Keys. One API key, many hosted models, OpenAI-
# compatible. Defaults are the cleanest models from the 31 Oct bench pilot:
# GLM-5.3 Flash routes, GPT-6 Luna (reasoning + vision) handles Socratic
# replies, practice questions AND photo homework help when it serves the
# reasoner tier (LLM_PROVIDER=openrouter, or REASONER_PROVIDER=openrouter below).
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_ROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_REASONER_MODEL=openai/gpt-6-luna
OPENROUTER_VISION_MODEL=openai/gpt-6-luna

# ── Intent router tier (optional; defaults to the LLM_PROVIDER above)
# jev = TypeSafe AI's Jev — typed decisions with calibrated confidence, not text.
# Waitlisted early access: https://typesafe.ai → console.typesafe.ai for a key.
# Below JEV_MIN_CONFIDENCE the router falls back to the LLM/stub classifier.
# Compare providers with:  docker compose run --rm evals python -m evals.router_eval
ROUTER_PROVIDER=
TYPESAFE_API_KEY=REPLACE_ME
JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.6

# ── Reasoner tier (optional; defaults to the LLM_PROVIDER above)
# Tutoring, practice questions, grading, photo help and eval answers. Set it to
# split the tiers, e.g. LLM_PROVIDER=groq (cheap routing) + REASONER_PROVIDER=
# anthropic (tutoring). Uses that provider's *_REASONER_MODEL and API key.
# Values: (blank) | stub | anthropic | groq | ollama | openrouter
REASONER_PROVIDER=

# ── Reasoning effort per tier (blank = each call's built-in default)
# none | minimal | low | medium | high. The model bake-off (evals/bench)
# measures which level each tier needs; set the winners here.
ROUTER_EFFORT=
REASONER_EFFORT=
# Pin open models on OpenRouter to one host, e.g. Groq (no silent reroutes).
OPENROUTER_PROVIDER=
# Prompt layout for tutoring replies: classic | layered (cache-friendly:
# rules + grade frame + learner profile first, the session as chat, this
# turn last). Compare with: python -m app.reports.cache_eval
PROMPT_LAYOUT=classic
# OpenRouter sticky routing per learner (session_id), and the cache lifetime
# assumed when estimating cacheable tokens.
OPENROUTER_SESSION_IDS=true
CACHE_TTL_SECONDS=600

# ── Speech-to-text for voice notes
# stub = fixed transcript | local = faster-whisper container (no key) | openai = Whisper API
# groq = Groq-hosted Whisper (GROQ_API_KEY; GROQ_STT_MODEL=whisper-large-v3 or whisper-large-v3-turbo)
STT_PROVIDER=local
STT_BASE_URL=http://stt:9000
OPENAI_API_KEY=REPLACE_ME

# ── Embeddings for RAG over the CAPS corpus
# hash = deterministic offline embedder (no key) | openai = text-embedding-3-small
EMBEDDINGS_PROVIDER=hash
EMBEDDING_DIM=384

# ── Infra (matches docker-compose.yml; no changes needed locally)
DATABASE_URL=postgresql://katlego:katlego@db:5432/katlego
REDIS_URL=redis://redis:6379/0

# Safeguarding (child-safety layer 4): WhatsApp number (with country code, no +) that receives an alert the moment a learner message is flagged for self-harm/abuse risk -- e.g. your own number for now.
SAFEGUARDING_ALERT_PHONE=

{"case_id": "m52", "rep": 0, "suite": "maths", "variant": "qwen__qwen3.5-35b-a3b@low", "model": "qwen/qwen3.5-35b-a3b", "effort": "low", "group": "open", "status": "ok", "grade_level": 12, "tags": ["Functions and inverse functions", "grade12"], "output": "$y = 3x - 6$  $\\qquad$ [Interchange $x$ and $y$]\n$x = 3y - 6$  $\\qquad$ [Make $y$ the subject]\n$x + 6 = 3y$\n$y = \\frac{x + 6}{3}$\n\n$f^{-1}(x) = \\frac{x + 6}{3}$\n\n(Alternatively: $f^{-1}(x) = \\frac{1}{3}x + 2$)", "pred": null, "grade": {"correct": 1.0}, "judge": null, "latency_s": 60.427, "calls": 1, "input_tokens": 427, "output_tokens": 1317, "reasoning_tokens": 1056, "cost_usd": 0.001377, "served_models": ["qwen/qwen3.5-35b-a3b"], "hosts": ["DeepInfra"], "finish_reasons": ["stop"], "judge_cost_usd": 0.0, "ts": "2026-10-31T18:09:46"}

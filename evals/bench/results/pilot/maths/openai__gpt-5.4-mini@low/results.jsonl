{"case_id": "m52", "rep": 0, "suite": "maths", "variant": "openai__gpt-5.4-mini@low", "model": "openai/gpt-5.4-mini", "effort": "low", "group": "openai", "status": "ok", "grade_level": 12, "tags": ["Functions and inverse functions", "grade12"], "output": "Let \\(y = 3x - 6\\)\n\nInterchange \\(x\\) and \\(y\\):\n\n\\[\nx = 3y - 6\n\\]\n\nSolve for \\(y\\):\n\n\\[\nx + 6 = 3y\n\\]\n\n\\[\ny = \\frac{x+6}{3}\n\\]\n\nTherefore,\n\n\\[\n\\boxed{f^{-1}(x)=\\frac{x+6}{3}}\n\\]", "pred": null, "grade": {"correct": 1.0}, "judge": null, "latency_s": 1.713, "calls": 1, "input_tokens": 406, "output_tokens": 107, "reasoning_tokens": 9, "cost_usd": 0.000786, "served_models": ["openai/gpt-5.4-mini"], "hosts": ["OpenAI"], "finish_reasons": ["stop"], "judge_cost_usd": 0.0, "ts": "2026-10-31T18:04:47"}

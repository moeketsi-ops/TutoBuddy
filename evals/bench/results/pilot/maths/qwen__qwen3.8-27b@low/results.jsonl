{"case_id": "m52", "rep": 0, "suite": "maths", "variant": "qwen__qwen3.8-27b@low", "model": "qwen/qwen3.8-27b", "effort": "low", "group": "open", "status": "ok", "grade_level": 12, "tags": ["Functions and inverse functions", "grade12"], "output": "**Determine f⁻¹(x) if f(x) = 3x − 6**\n\nLet y = 3x − 6\n\nInterchange x and y:\nx = 3y − 6\n\nSolve for y:\nx + 6 = 3y\n\n$$f^{-1}(x) = \\frac{x + 6}{3}$$", "pred": null, "grade": {"correct": 1.0}, "judge": null, "latency_s": 1.915, "calls": 1, "input_tokens": 453, "output_tokens": 215, "reasoning_tokens": 133, "cost_usd": 0.000628, "served_models": ["qwen/qwen3.8-27b"], "hosts": ["ModelRun"], "finish_reasons": ["stop"], "judge_cost_usd": 0.0, "ts": "2026-10-31T18:08:26"}
